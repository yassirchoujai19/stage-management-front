# Copy to .env.development / .env.production and adjust.
# Only vars prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets here - the built JS is public.

# Where the frontend sends API calls.
#  - "/api"                    -> goes through the Vite dev proxy (no CORS setup needed)
#  - "http://localhost:8000/api" -> direct call (backend must send CORS headers)
VITE_API_BASE_URL=/api

# Only used by the Vite dev proxy (server-side, not shipped to the browser)
VITE_PROXY_TARGET=http://localhost:8000

# Where the auth token lives: "localStorage" (survives reload) or "sessionStorage" (dies with the tab)
VITE_TOKEN_STORAGE=localStorage

# Fake in-memory backend (src/services/mock). Set to false the day the API is live.
VITE_USE_MOCK_API=true
